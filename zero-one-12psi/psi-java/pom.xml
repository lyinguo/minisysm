<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zeroone.star</groupId>
        <artifactId>zero-one-cloud-build</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <artifactId>psi-java</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>awei</name>
            <organization>Zero One Star</organization>
        </developer>
    </developers>
    <repositories>
        <repository>
            <id>2383166-snapshot-6TSW5l</id>
            <url>https://packages.aliyun.com/maven/repository/2383166-snapshot-6TSW5l</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <modules>
        <module>psi-common</module>
        <module>psi-domain</module>
        <module>psi-apis</module>
        <module>psi-oauth2</module>
        <module>psi-gateway</module>
        <module>psi-login</module>
        <module>psi-doc</module>
        <module>psi-j1-homepage</module>
        <module>psi-j1-sysconfig</module>
        <module>psi-j2-storemanagement</module>
        <module>psi-sale</module>
        <module>psi-fund</module>
        <module>psi-j5-reportmanagement</module>
        <module>psi-j6-basic_information</module>
        <module>psi-j6-payment_order</module>
        <module>psi-j7-supportinfo</module>
        <module>psi-j7-moneytransfer</module>
        <module>psi-j8-finance</module>
        <module>psi-j8-report</module>
        <module>psi-j3-purchase</module>
        <module>psi-j3-capital</module>
    </modules>
    <properties>
        <!-- 项目版本号 -->
        <revision>1.0.0-SNAPSHOT</revision>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- 系统内容公用模块定义 -->
            <dependency>
                <groupId>com.zeroone.star</groupId>
                <artifactId>psi-apis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeroone.star</groupId>
                <artifactId>psi-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeroone.star</groupId>
                <artifactId>psi-domain</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <!-- Resolve ${revision} when installing to local .m2 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.2.7</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

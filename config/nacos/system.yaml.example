spring:
  cloud:
    inetutils:
      preferred-networks:
      - 192.168
      - 127.0
      - 10.0
      ignored-interfaces:
      - docker0
      - veth.*
      - VM.*
      - br-.*
      - vEthernet.*
      - Hyper-V.*
      - eth.*
      - Loopback Pseudo-Interface.*
zo:
  cloud:
    starter:
      gateway:
        open-authorization: false
        white-paths:
        - /actuator/**
        - /captcha/**
        - /auth/oauth/token
        - /login/auth-login
        - /login/refresh-token
        inner-paths:
        - /login/current-user
        - /login/get-menus
        - /login/logout
        - /homepage/**
  captcha:
    enabled: false

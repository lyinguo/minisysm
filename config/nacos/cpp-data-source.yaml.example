spring:
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:127.0.0.1}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:zo_psi}?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: ${CPP_DATA_SOURCE_SPRING_DATASOURCE_USERNAME}
    password: ${CPP_DATA_SOURCE_SPRING_DATASOURCE_PASSWORD}
    druid:
      max-active: 5
  redis:
    host: 127.0.0.1
    port: 6379
    password: ${CPP_DATA_SOURCE_SPRING_REDIS_PASSWORD}
  data:
    mongodb:
      uri: ${MONGODB_URI}
